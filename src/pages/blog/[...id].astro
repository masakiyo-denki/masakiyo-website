---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const faqSchema = post.data.faq?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map((item: { q: string; a: string }) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
} : null;

const siteUrl = 'https://www.masakiyo-denki.com';
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "image": post.data.heroImage ? `${siteUrl}${post.data.heroImage}` : `${siteUrl}/images/shop-exterior.jpg`,
  "author": {
    "@type": "Organization",
    "name": "合資会社 正清電器",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "合資会社 正清電器",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/logo.jpg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${post.id}`
  }
};
---

<Layout
  title={`${post.data.title} | 正清電器`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
  ogImage={post.data.heroImage ?? post.data.image}
>
  <div class="max-w-3xl mx-auto px-4 py-16">
    <a href="/blog/" class="text-sm text-[var(--color-primary)] hover:underline mb-6 inline-block">← お知らせ一覧へ</a>
    <article>
      <div class="flex items-center gap-3 mb-3">
        <time class="text-sm text-gray-400">
          {post.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.category && (
          <span class="text-xs font-bold text-[var(--color-primary)] bg-blue-50 px-2 py-0.5 rounded">{post.data.category}</span>
        )}
      </div>
      <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-primary)] mb-6">{post.data.title}</h1>

      {(post.data.heroImage || post.data.image) && !post.body?.includes('<!-- body-images -->') && (
        <div class="mb-8 rounded-xl overflow-hidden">
          <img
            src={post.data.heroImage ?? post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            class="w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <div class="prose prose-blue max-w-none text-gray-700 leading-relaxed">
        <Content />
      </div>

      {/* frontmatter の faq: を人が読める形でも描画する。
          以前はJSON-LDだけを生成していたため、frontmatterにfaqを書いても
          画面には何も出ず、本文に手書きした記事だけFAQが見えている状態だった。
          AI概要向けにも「本文に見える形のQ&A」が効くため、ここで描画する。 */}
      {post.data.faq?.length ? (
        <section class="mt-14">
          <h2 class="text-2xl font-bold text-[var(--color-primary)] mb-6">よくある質問</h2>
          <div class="space-y-4">
            {post.data.faq.map((item: { q: string; a: string }) => (
              <details class="bg-[var(--color-bg-gray)] rounded-xl group">
                <summary class="cursor-pointer p-5 font-bold text-[var(--color-primary)] flex justify-between items-start gap-4">
                  <span>{item.q}</span>
                  <span class="shrink-0 text-xl group-open:rotate-45 transition-transform">+</span>
                </summary>
                <div class="px-5 pb-5 text-sm text-gray-700 leading-relaxed">{item.a}</div>
              </details>
            ))}
          </div>
        </section>
      ) : null}
    </article>

    <div class="mt-12 pt-8 border-t border-gray-200">
      <a href="/blog/" class="text-sm text-[var(--color-primary)] hover:underline">← お知らせ一覧へ戻る</a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>
